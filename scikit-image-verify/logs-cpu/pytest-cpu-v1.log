  >>> res2 = ski2.data.binary_blobs(
  ...     shape=(length,) * n_dim,
  ...     blob_size=blob_size_fraction * length,
  ...     boundary_mode='nearest',
  ...     rng=default_rng(1939)
  ... )
  >>> assert np.all(res1 == res2)
  
